{
  "schemaVersion": 1,
  "id": "hyperglide",
  "version": "${version}",
  "name": "Hyperglide",
  "description": "A Meteor addon focused on utility modules compatible with 2b2t",
  "authors": [
    "Arkieee"
  ],
  "icon": "assets/hyperglide/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "hyperglide.Hyperglide"
    ]
  },
  "mixins": [
    "mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
